# Copy to `.env` (never commit the real one):
#   cp env.example .env

# ---- Server ----
PORT=8080
# Public HTTPS origin of THIS service (Railway/Koyeb domain). Used for Twilio
# webhook signature validation.
PUBLIC_BASE_URL=https://your-voice-agent.up.railway.app
# Public wss URL of the Media Streams endpoint (same host, fixed path).
PUBLIC_WS_URL=wss://your-voice-agent.up.railway.app/media-stream

# ---- Telephony (Twilio) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Dev-only escape hatch to run without a public HTTPS URL (ngrok etc).
# NEVER true in production.
# TWILIO_SKIP_SIGNATURE_CHECK=false

# ---- STT / TTS (Deepgram) ----
DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_STT_MODEL=nova-2
# Hinglish: "multi" works for mixed Hindi+English; use "hi" or "en" for pure.
DEEPGRAM_LANGUAGE=multi
# Voice model for /v1/speak. Verify in the Deepgram console which Aura voices
# cover Hindi before launch; aura-asteria-en is English.
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ---- LLM (Groq) ----
GROQ_API_KEY=your_groq_key
# Per spec llama-3-8b-8192. If Groq reports it deprecated, llama-3.1-8b-instant
# is the drop-in replacement of the same size class.
GROQ_MODEL=llama-3-8b-8192

# ---- Doctor (dashboard) JWT sessions ----
# Secret signing doctor JWTs. Defaults to ADMIN_SESSION_SECRET if unset;
# set a dedicated one in production.
DOCTOR_JWT_SECRET=

# ---- Database ----
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/aarogya

# ---- Frontend (Socket.io / REST CORS) ----
FRONTEND_URL=https://your-app.vercel.app   # exact origin, no trailing slash

# ---- Super admin (hidden /aarogya-super-admin console) ----
# Admin ID (not an email — any unique string you choose).
SUPER_ADMIN_ID=your-admin-id
# PREFERRED: scrypt hash of the password — generate with:
#   npm run hash-password -- "your-long-password"
SUPER_ADMIN_PASSWORD_HASH=
# Fallback (NOT recommended): plaintext password, only used if the hash is unset.
# SUPER_ADMIN_PASSWORD=
# Random secret signing admin session tokens (openssl rand -base64 32).
ADMIN_SESSION_SECRET=
